#!/usr/bin/env bash
# berth-secret-drop KEY: hand a secret to the host from inside the org, without typing it there
# (#10). Run it in the org's own terminal (the browser terminal, SSH, attach): it reads the value
# hidden and leaves it in a one-time drop. On the host, `berth env <org> accept` then stores it as
# the org's variable KEY and removes the drop; it reaches every session at the org's next restart.
#
#   berth-secret-drop KEY           read the value (hidden; or one line of stdin) and drop it
#   berth-secret-drop --list        the names waiting to be accepted
#   berth-secret-drop --cancel KEY  take a drop back
#   berth-secret-drop --show KEY    print a dropped value (what `berth env <org> accept` reads)
#
# The host decides: it checks the name as `berth env set` does and may refuse it. Until it accepts,
# nothing in the org changes.
set -euo pipefail

DIR="${BERTH_DROP_DIR:-$HOME/.config/berth-drop}"
ORG=$(cat /etc/claude-env/org 2>/dev/null || echo "<org>")
die() { echo "berth-secret-drop: $*" >&2; exit 1; }
key_ok() { [[ "${1:-}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "KEY must look like OPENROUTER_API_KEY (letters, digits and _, not starting with a digit)"; }

case "${1:-}" in
  --list)
    [ -d "$DIR" ] || exit 0
    for f in "$DIR"/*; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      k=${f##*/}; [[ "$k" =~ ^[A-Z_][A-Z0-9_]*$ ]] && echo "$k"
    done
    exit 0 ;;
  --cancel)
    key_ok "${2:-}"
    [ -e "$DIR/$2" ] || [ -L "$DIR/$2" ] || die "nothing dropped for $2"
    rm -f "$DIR/$2"; echo "Cancelled: $2"
    exit 0 ;;
  --show)
    key_ok "${2:-}"
    # A regular file only: never a link to something else in here.
    [ -f "$DIR/$2" ] && [ ! -L "$DIR/$2" ] || die "nothing dropped for $2"
    cat "$DIR/$2"
    exit 0 ;;
  ""|-h|--help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  -*) die "unknown option $1 (--list, --cancel KEY, --show KEY)" ;;
esac

key="$1"; key_ok "$key"
[ $# -eq 1 ] || die "the value is read from the terminal or stdin, never from the command line"
if [ -t 0 ]; then
  printf 'Value for %s (hidden): ' "$key" >&2
  IFS= read -rs val || true
  echo >&2
else
  IFS= read -r val || true
fi
[ -n "$val" ] || die "empty value; nothing dropped"
case "$val" in *"'"*) die "values containing a single quote (') aren't supported" ;; esac

umask 077
mkdir -p "$DIR"
[ ! -L "$DIR" ] || die "$DIR is a link; refusing to write through it"
tmp=$(mktemp "$DIR/.drop.XXXXXX")
printf '%s' "$val" > "$tmp"
mv -f "$tmp" "$DIR/$key"
echo "Dropped $key. It isn't set yet: on the host, run  berth env $ORG accept"
