#!/usr/bin/env bash
# Chooses how git reaches github.com in this org (#103), and writes it to git's system config:
#   https  the gh CLI is signed in: git uses its token, through git-remote-berth
#   ssh    it isn't, or org.env has GIT_TRANSPORT=ssh: git uses the org's key, through git-ssh-guard
# Both only connect for repos in /config/repos.txt. Runs as root: at container start, every 30
# seconds after (a sign-in or sign-out inside the container is picked up), and from `berth account gh`.
#   git-transport apply   choose, and rewrite the config if the choice changed
#   git-transport show    print the current choice
set -euo pipefail

STATE=/run/git-transport
RULES=/etc/claude-env/git-transport.gitconfig   # included by git's system config (Dockerfile)

if [ "${1:-apply}" = show ]; then cat "$STATE" 2>/dev/null || echo ssh; exit 0; fi

want=ssh
# Only gh's own login counts (berth account gh), not a GH_TOKEN variable: this runs with the container's
# environment at start and with docker exec's from berth, and both must choose the same.
if [ "${GIT_TRANSPORT:-auto}" != ssh ] \
   && runuser -u node -- env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com >/dev/null 2>&1; then
  want=https
fi
[ "$want" != "$(cat "$STATE" 2>/dev/null || true)" ] || exit 0

# Written whole and moved into place: git never reads a half-written set of rules.
if [ "$want" = https ]; then
  printf '[url "berth::https://github.com/"]\n'
  printf '\tinsteadOf = %s\n' "https://github.com/" "http://github.com/" "git@github.com:" "ssh://git@github.com/"
else
  printf '[url "git@github.com:"]\n'
  printf '\tinsteadOf = %s\n' "https://github.com/" "http://github.com/"
fi > "$RULES.new"
chmod 644 "$RULES.new" && mv "$RULES.new" "$RULES"
echo "$want" > "$STATE"
echo "git: github.com over $want"
