# Minimal sshd for the host/ssh integration test. Several host key types on purpose: the client
# must negotiate the one pinned in berth's known_hosts, not whichever the server prefers.
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthorizedKeysFile .ssh/authorized_keys
# The Docker engine is reached through a direct-streamlocal channel to its unix socket.
AllowStreamLocalForwarding yes
# Not "AllowTcpForwarding no": OpenSSH checks it for unix-socket forwarding too, so it would
# block the Docker channel even with AllowStreamLocalForwarding yes.
Subsystem sftp internal-sftp
LogLevel VERBOSE
